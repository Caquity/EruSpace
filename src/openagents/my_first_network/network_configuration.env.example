# OpenAgents Network Configuration
# Copy this file to network_configuration.env and fill in your API keys

# Network Configuration
NETWORK_HOST=localhost
NETWORK_PORT=8700
NETWORK_ID=cqy-eru-1

# API Keys (replace with your own)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEMINI_API_KEY=your_gemini_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Docker Deployment Notes:
# 1. For local development: Use the .env file
# 2. For Docker/Zeabur: Set these as environment variables in your deployment platform
# 3. NEVER commit real API keys to git!
